# Database
DATABASE_URL=postgresql://user:password@host:5432/dispatch_db

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Samsara API (Optional - geofence will gracefully degrade without it)
SAMSARA_API_TOKEN=samsara_api_your_token_here
SAMSARA_BASE_URL=https://api.samsara.com

# Geofence Worker
GEOFENCE_ENABLED=true
GEOFENCE_POLL_CRON=*/3 * * * *
GEOFENCE_RADIUS_M=500

# Auto Ingest Worker
AUTO_INGEST_ENABLED=false
AUTO_INGEST_POLL_CRON=*/2 * * * *

# Supabase (Optional - for document storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Gemini AI (Optional - for tender PDF parsing)
GOOGLE_AI_API_KEY=your-gemini-api-key

# Notifications (Optional)
DETENTION_NOTIFY_EMAIL=dispatch@company.com
RATE_REQUEST_NOTIFY_EMAIL=sales@company.com

# Port
PORT=5555

# Environment
NODE_ENV=production
